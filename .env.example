# =============================================================================
# WhatsGo Production Environment Configuration
# Copy this file to .env.production and update the values
# =============================================================================

# ─── Backend ────────────────────────────────────────────────────────────────
PORT=8080
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
# Database connection URL (pick one):
#   SQLite (default):     sqlite:///app/data/whatsgo.db
#   PostgreSQL:           postgres://whatsgo:password@localhost:5432/whatsgo?sslmode=disable
#   MariaDB/MySQL:        mysql://whatsgo:password@localhost:3306/whatsgo
DATABASE_URL=sqlite:///app/data/whatsgo.db
DATA_DIR=/app/data
WEBHOOK_WORKERS=10
WEBHOOK_QUEUE_SIZE=1000
RATE_LIMIT_RPM=100
MAX_MEDIA_SIZE=16
ALLOWED_ORIGINS=http://localhost,https://yourdomain.com
ECHO_BOT=0
GIN_MODE=release

# ─── Frontend ───────────────────────────────────────────────────────────────
# Leave empty to use relative URLs (nginx proxy handles routing)
# Set to a full URL if frontend is on a different domain than the API
VITE_API_URL=

# ─── Docker ─────────────────────────────────────────────────────────────────
# Port exposed on the host machine
APP_PORT=80
